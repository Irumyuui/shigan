{
  "name": "shigan",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.3",
  "publisher": "miyana-tobari",
  "author": {
    "name": "宮凪帷"
  },
  "license": "MIT",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "c",
    "cpp",
    "c++",
    "csharp",
    "rust",
    "bracket",
    "preprocessor",
    "matching"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:rust"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "%configuration.title%",
        "properties": {
          "shigan.enable": {
            "type": "boolean",
            "default": true,
            "description": "%shigan.enable.description%"
          },
          "shigan.languages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "c",
              "cpp",
              "csharp",
              "rust"
            ],
            "description": "%shigan.languages.description%"
          },
          "shigan.trigger": {
            "type": "string",
            "enum": [
              "cursor",
              "always",
              "hover",
              "off"
            ],
            "default": "cursor",
            "markdownDescription": "%shigan.trigger.markdownDescription%"
          },
          "shigan.show": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "brackets",
                "macros"
              ]
            },
            "default": [
              "brackets",
              "macros"
            ],
            "description": "%shigan.show.description%"
          },
          "shigan.showRange": {
            "type": "boolean",
            "default": true,
            "description": "%shigan.showRange.description%"
          },
          "shigan.showRangeThreshold": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "description": "%shigan.showRangeThreshold.description%"
          },
          "shigan.showLabel": {
            "type": "boolean",
            "default": true,
            "description": "%shigan.showLabel.description%"
          },
          "shigan.inactive.skipBrackets": {
            "type": "boolean",
            "default": true,
            "description": "%shigan.inactive.skipBrackets.description%"
          },
          "shigan.inactive.skipDirectives": {
            "type": "boolean",
            "default": false,
            "description": "%shigan.inactive.skipDirectives.description%"
          },
          "shigan.inactive.markInactive": {
            "type": "boolean",
            "default": true,
            "description": "%shigan.inactive.markInactive.description%"
          }
        }
      },
      {
        "id": "shigan.c",
        "title": "%shigan.configuration.c%",
        "order": 1,
        "properties": {
          "shigan.c.trackFileDefines": {
            "type": "boolean",
            "default": true,
            "description": "%shigan.c.trackFileDefines.description%"
          },
          "shigan.c.compileFlags": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "%shigan.c.compileFlags.itemDescription%"
            },
            "default": [],
            "markdownDescription": "%shigan.c.compileFlags.markdownDescription%"
          },
          "shigan.c.inheritCompileCommands": {
            "type": "boolean",
            "default": false,
            "description": "%shigan.c.inheritCompileCommands.description%"
          }
        }
      },
      {
        "id": "shigan.cpp",
        "title": "%shigan.configuration.cpp%",
        "order": 2,
        "properties": {
          "shigan.cpp.trackFileDefines": {
            "type": "boolean",
            "default": true,
            "description": "%shigan.cpp.trackFileDefines.description%"
          },
          "shigan.cpp.compileFlags": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "%shigan.cpp.compileFlags.itemDescription%"
            },
            "default": [],
            "markdownDescription": "%shigan.cpp.compileFlags.markdownDescription%"
          },
          "shigan.cpp.inheritCompileCommands": {
            "type": "boolean",
            "default": false,
            "description": "%shigan.cpp.inheritCompileCommands.description%"
          }
        }
      },
      {
        "id": "shigan.csharp",
        "title": "%shigan.configuration.csharp%",
        "order": 3,
        "properties": {
          "shigan.csharp.trackFileDefines": {
            "type": "boolean",
            "default": true,
            "description": "%shigan.csharp.trackFileDefines.description%"
          },
          "shigan.csharp.compileFlags": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "%shigan.csharp.compileFlags.itemDescription%"
            },
            "default": [],
            "markdownDescription": "%shigan.csharp.compileFlags.markdownDescription%"
          },
          "shigan.csharp.define": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%shigan.csharp.define.description%"
          },
          "shigan.csharp.inheritProject": {
            "type": "boolean",
            "default": true,
            "description": "%shigan.csharp.inheritProject.description%"
          },
          "shigan.csharp.configuration": {
            "type": "string",
            "default": "Debug",
            "description": "%shigan.csharp.configuration.description%"
          },
          "shigan.csharp.targetFramework": {
            "type": "string",
            "default": "",
            "description": "%shigan.csharp.targetFramework.description%"
          }
        }
      },
      {
        "id": "shigan.rust",
        "title": "%shigan.configuration.rust%",
        "order": 4,
        "properties": {
          "shigan.rust.cfg": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%shigan.rust.cfg.description%"
          },
          "shigan.rust.inheritCargo": {
            "type": "boolean",
            "default": true,
            "description": "%shigan.rust.inheritCargo.description%"
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build:integration": "esbuild test/integration/*.test.ts --bundle --platform=node --format=cjs --external:vscode --outdir=out/integration",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "bun run build && bun run build:integration && node ./node_modules/@vscode/test-cli/out/bin.mjs",
    "test": "bun run test:unit",
    "inspect": "bun run scripts/inspect.ts",
    "clean": "node scripts/clean.mjs",
    "package": "node scripts/package.mjs",
    "package:min": "node scripts/package.mjs --minify",
    "install:vsix": "node scripts/package.mjs --install",
    "release": "bun run scripts/release.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
